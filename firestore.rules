rules_version = '2';

// ATEC교육장 예약시스템 Firestore 보안규칙 (초안)
// Firebase 콘솔 > Firestore Database > 규칙 에 붙여넣고 [게시] 한다.
//
// 설계 의도
//  - 예약 현황(시간표)은 로그인 없이 누구나 조회할 수 있어야 한다.
//  - 신청은 누구나 할 수 있되, 항상 '승인 대기' 상태이고 주의사항에 동의한 건이어야 한다.
//  - 승인·거절·수정·삭제는 admins 컬렉션에 등록된 담당자만 할 수 있다.

service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인한 사용자의 이메일이 admins 컬렉션에 등록되어 있는지 확인
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /reservations/{resId} {

      // 예약 현황 조회는 공개
      allow read: if true;

      // 신청(생성) — 누구나 가능하지만 아래 조건을 모두 만족해야 한다
      allow create: if
        // 필수 필드가 모두 있어야 한다
        request.resource.data.keys().hasAll([
          'room', 'date', 'startTime', 'endTime', 'eventName', 'manager',
          'attendees', 'purpose', 'status', 'rejectReason',
          'agreed', 'signedName', 'signedAt', 'agreementVersion'
        ])
        // 신청은 반드시 '승인 대기' 상태로만 만들 수 있다 (자가 승인 방지)
        && request.resource.data.status == 'pending'
        && request.resource.data.rejectReason == ''
        // 주의사항 동의와 서명이 반드시 있어야 한다
        && request.resource.data.agreed == true
        && request.resource.data.signedName is string
        && request.resource.data.signedName.size() >= 2
        && request.resource.data.signedName.size() <= 20
        && request.resource.data.signedAt is string
        // 교육장 식별자는 정해진 값만 허용한다 (ROOMS 배열을 바꾸면 여기도 함께 고칠 것)
        && request.resource.data.room in ['video', 'seminar']
        // 입력값 길이·형식 제한 (화면 검증을 우회한 직접 요청 대비)
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.endTime.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.eventName is string
        && request.resource.data.eventName.size() > 0
        && request.resource.data.eventName.size() <= 60
        && request.resource.data.manager is string
        && request.resource.data.manager.size() >= 2
        && request.resource.data.manager.size() <= 20
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() > 0
        && request.resource.data.purpose.size() <= 300
        && request.resource.data.attendees is int
        && request.resource.data.attendees > 0
        && request.resource.data.attendees <= 80;

      // 승인·거절·삭제는 담당자만
      allow update, delete: if isAdmin();
    }

    // 담당자 명단 — 로그인한 사용자가 자신의 권한을 확인할 수 있어야 하므로 읽기는 허용,
    // 추가·삭제는 Firebase 콘솔에서만 한다.
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 그 외 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
